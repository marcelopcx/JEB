meta {
  name: Clear Cart
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/cart/{{userId}}
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8080/JEB-1.0-SNAPSHOT/api
  userId: user1
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("cart is empty", function() {
    expect(res.body.items).to.be.an("array");
    expect(res.body.items.length).to.equal(0);
  });
}
