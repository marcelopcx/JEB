meta {
  name: Remove Item From Cart
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/cart/{{userId}}/items/{{productId}}
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8080/JEB-1.0-SNAPSHOT/api
  userId: user1
  productId: 1
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
}
