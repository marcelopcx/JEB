meta {
  name: Get Product By Id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/products/{{productId}}
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8080/JEB-1.0-SNAPSHOT/api
  productId: 1
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("product has id", function() {
    expect(res.body.id).to.equal(Number(bru.getEnvVar("productId")));
  });
}
